{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "miuix-vue": [
        "./node_modules/miuix-vue/dist/src/index.d.ts"
      ],
      "miuix-vue/icons": [
        "./node_modules/miuix-vue/dist/src/icons/extended/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}
