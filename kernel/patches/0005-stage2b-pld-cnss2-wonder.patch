+/**
+ * cnss_vendor_wonder_comp_bind - vendor wonder device component bind
+ *  callback
+ * @comp: vendor wonder device
+ * @master: master device
+ * @master_data: master data
+ *
+ * Return: 0 on success else errno
+ */
+static
+int cnss_vendor_wonder_comp_bind(struct device *comp, struct device *master,
+				 void *master_data)
+{
+	cnss_pr_info("vendor wonder bound to master device %s\n",
+		     dev_name(master));
+	return 0;
+}
+
+/**
+ * cnss_vendor_wonder_comp_unbind - vendor wonder device component unbind
+ *  callback
+ * @comp: vendor wonder device
+ * @master: master device
+ * @master_data: master data
+ *
+ * Return: None
+ */
+static
+void cnss_vendor_wonder_comp_unbind(struct device *comp, struct device *master,
+				    void *master_data)
+{
+	cnss_pr_info("vendor wonder unbound to master device\n");
+}
+
+static struct platform_device *wonder_plat_dev;
+static const void *wonder_priv_data;
+/* true when the provider device was created by us (no DT node on this
+ * product); such a device is unregistered again by us.
+ */
+static bool wonder_plat_dev_self_created;
+static bool wonder_component_added;
+
+static const struct component_ops wonder_comp_ops = {
+	.bind = cnss_vendor_wonder_comp_bind,
+	.unbind = cnss_vendor_wonder_comp_unbind,
+};
+
+static inline int cnss_add_vendor_wonder_component(void)
+{
+	int ret;
+
+	platform_set_drvdata(wonder_plat_dev, (void *)wonder_priv_data);
+
+	ret = component_add(&wonder_plat_dev->dev, &wonder_comp_ops);
+	if (!ret)
+		wonder_component_added = true;
+
+	return ret;
+}
+
+static inline void cnss_del_vendor_wonder_component(void)
+{
+	if (wonder_component_added) {
+		component_del(&wonder_plat_dev->dev, &wonder_comp_ops);
+		wonder_component_added = false;
+	}
+
+	platform_set_drvdata(wonder_plat_dev, NULL);
+}
+
+/**
+ * cnss_create_vendor_wonder_plat_dev - create the vendor wonder provider
+ *  platform device
+ *
+ * Products that do not describe the vendor wonder provider in their device
+ * tree get no platform device from DT. Create it from code so that the
+ * vendor wonder driver can still bind to it by name.
+ *
+ * Return: 0 on success else errno
+ */
+static int cnss_create_vendor_wonder_plat_dev(void)
+{
+	int ret;
+
+	wonder_plat_dev = platform_device_alloc(CNSS_WONDER_PROVIDER_NAME, -1);
+	if (!wonder_plat_dev) {
+		cnss_pr_err("Failed to allocate vendor wonder plat device\n");
+		return -ENOMEM;
+	}
+
+	/* the vendor wonder driver can probe as soon as the device is added,
+	 * make the private data visible before it is registered
+	 */
+	platform_set_drvdata(wonder_plat_dev, (void *)wonder_priv_data);
+
+	ret = platform_device_add(wonder_plat_dev);
+	if (ret) {
+		cnss_pr_err("Failed to add vendor wonder plat device, ret = %d\n",
+			    ret);
+		platform_device_put(wonder_plat_dev);
+		wonder_plat_dev = NULL;
+		return ret;
+	}
+
+	wonder_plat_dev_self_created = true;
+	cnss_pr_info("Created vendor wonder plat device %s\n",
+		     dev_name(&wonder_plat_dev->dev));
+
+	return 0;
+}
+
+int cnss_set_vendor_wonder_priv_data(const void *priv_data)
+{
+	int ret;
+
+	wonder_priv_data = priv_data;
+
+	if (!wonder_plat_dev) {
+		if (!wonder_priv_data) {
+			cnss_pr_info("vendor wonder plat device not available\n");
+			return 0;
+		}
+
+		/* no provider device from device tree on this product */
+		ret = cnss_create_vendor_wonder_plat_dev();
+		if (ret)
+			return ret;
+	}
+
+	if (wonder_priv_data)
+		cnss_add_vendor_wonder_component();
+	else
+		cnss_del_vendor_wonder_component();
+
+	return 0;
+}
+EXPORT_SYMBOL(cnss_set_vendor_wonder_priv_data);
+
+static int cnss_vendor_wonder_dev_probe(struct platform_device *plat_dev)
+{
+	if (!wonder_plat_dev) {
+		cnss_pr_info("wlan vendor wonder device probed!\n");
+		wonder_plat_dev = plat_dev;
+
+		if (wonder_priv_data)
+			return cnss_add_vendor_wonder_component();
+
+		return 0;
+	} else {
+		cnss_pr_info("wlan vendor wonder device already exists!\n");
+		return -EEXIST;
+	}
+}
+
+static void cnss_vendor_wonder_dev_remove(void)
+{
+	if (wonder_plat_dev && wonder_priv_data)
+		cnss_del_vendor_wonder_component();
+
+	cnss_pr_info("wlan vendor wonder device removed!\n");
+
+	/* the provider device was created by us, release it now */
+	if (wonder_plat_dev && wonder_plat_dev_self_created) {
+		platform_device_unregister(wonder_plat_dev);
+		wonder_plat_dev_self_created = false;
+	}
+
+	wonder_plat_dev = NULL;
+	wonder_priv_data = NULL;
+}
+
 static int cnss_probe(struct platform_device *plat_dev)
 {
 	int ret = 0;
@@ -5870,6 +6047,8 @@ static int cnss_probe(struct platform_device *plat_dev)
 	if (device_id->driver_data == DIRECT_LINK_DEVICE_ID) {
 		cnss_pr_info("cnss direct link device probed!\n");
 		return 0;
+	} else if (device_id->driver_data == WONDER_VENDOR_DEVICE_ID) {
+		return cnss_vendor_wonder_dev_probe(plat_dev);
 	}
 
 	if (cnss_get_plat_priv(plat_dev)) {
@@ -6069,6 +6248,9 @@ static void cnss_remove(struct platform_device *plat_dev)
 	if (device_id->driver_data == DIRECT_LINK_DEVICE_ID) {
 		cnss_pr_info("cnss direct link device removed!\n");
 		goto out;
+	} else if (device_id->driver_data == WONDER_VENDOR_DEVICE_ID) {
+		cnss_vendor_wonder_dev_remove();
+		goto out;
 	}
 
 	plat_priv->audio_iommu_domain = NULL;
@@ -6202,6 +6384,11 @@ static int __init cnss_initialize(void)
 static void __exit cnss_exit(void)
 {
 	cnss_genl_exit();
+
+	/* release the provider device we created ourselves */
+	if (wonder_plat_dev && wonder_plat_dev_self_created)
+		cnss_vendor_wonder_dev_remove();
+
 	platform_driver_unregister(&cnss_platform_driver);
 	cnss_debug_deinit();
 }
