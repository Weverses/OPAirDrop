# ROM already provides mosey_app / mosey_service / mosey_server types.
# Native daemon is explicitly launched by the existing KernelSU domain.
allow ksu mosey_service service_manager { add find };
allow ksu servicemanager binder { call transfer };
allow servicemanager ksu binder { call transfer };
allow mosey_app ksu binder { call transfer };
allow mosey_app ksu fd use;
allow mosey_app mosey_service service_manager find;
allow ksu mosey_server_exec file { read open execute execute_no_trans map getattr };
